<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
"-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gn.mapper.StudentMapper">
	<resultMap id="studentResultMap" type="com.gn.dto.Student">
		<result property="studentNo" column="student_no"/>
		<result property="studentName" column="student_name"/>
		<result property="studentAge" column="student_age"/>
	</resultMap>

<!-- resultMap :  SQL 결과(ResultSet)를 Java 객체로 매핑할 때 사용하는 설정 -->
<!-- SELECT *를 쓰면 안됨 
	??? -->
	
	<select id="selectAll" resultMap="studentResultMap">
		SELECT *
			FROM student
	</select>
	
	<select id="selectOne" resultMap="studentResultMap">
		SELECT * FROM student
			<where>
				student_no = #{studentNo}
			</where>
	</select>
	
	<select id="selectOneByName" resultType="com.gn.dto.Student" parameterType="string">
		SELECT student_no AS studentNo,
			student_name AS studentName,
			student_age AS studentAge
			FROM student
			WHERE student_name LIKE CONCAT('%', #{studentName}, '%')
	</select>
	
	<insert id="insert" parameterType="com.gn.dto.Student">
		INSERT INTO student (student_name, student_age)
		VALUES (#{studentName}, #{studentAge})
	</insert>
	
	<update id="update" parameterType="com.gn.dto.Student">
		UPDATE student
		SET student_name = #{studentName},
			student_age= #{studentAge}
			<where>
				student_no = #{studentNo}
			</where>
			
	</update>
	
	<!-- parameterType= 은 파라미터 타입(#{})을 쓸 때만 써줌 -->
	<delete id="delete" parameterType="_int">
		DELETE FROM student 
		<where>
			student_no = #{studentNo}
		</where>
	</delete>
	
</mapper>